# Brief Eval Rig environment variables.
# Copy to `.env` (which is gitignored) and fill in real values.
#
# Phase 0 reads NONE of these. They land in Phase 1 (cloud adapters)
# and Phase 3 (LLM judge orchestration). Listed here so contributors
# know what credentials a full eval run will require.

# Anthropic API key.
# Used by: Claude Sonnet 4.7 contender adapter (Phase 1),
# Claude Opus 4.7 LLM judge (Phase 3).
ANTHROPIC_API_KEY=

# OpenAI API key.
# Used by: GPT-5 judge swap when grading Claude Sonnet outputs (Phase 3).
# Self-grading bias mitigation per spec §6.
OPENAI_API_KEY=

# OpenRouter API key.
# Used by: Qwen3.6 Flash, Qwen3.6 27B (cloud), Nemotron 3 Nano Omni
# (cloud) contender adapters (Phase 1).
OPENROUTER_API_KEY=

# Google AI Studio API key.
# Used by: Gemini 3.1 Pro Preview, Gemini 3 Flash Preview adapters
# (Phase 1).
GOOGLE_AI_STUDIO_API_KEY=
